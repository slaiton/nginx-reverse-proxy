# Reverse Proxy Nginx - Variables de Entorno
# (Este archivo es solo referencia; nginx no usa variables de entorno,
#  la configuración es 100% en nginx.conf y conf.d/*.conf)

# Dominio principal
MAIN_DOMAIN=api.innvestock.com

# Puerto del Reverse Proxy (generalmente 80 y 443, abiertos en docker-compose.yml)
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Proyectos internos (solo referencia, actualizar en conf.d/*.conf)
LOGISTICA_API_INTERNAL_PORT=8080
OTRO_PROYECTO_INTERNAL_PORT=8081
